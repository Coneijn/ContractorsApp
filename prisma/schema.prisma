// prisma/schema.prisma

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ==========================================
// ENUMS (Estados válidos en el sistema)
// ==========================================

enum UserRole {
  ADMIN
  OPS_MANAGER
  SALES
}

enum SubcontractorStatus {
  ACTIVE
  INACTIVE
}

enum PropertyStatus {
  RENOVATING
  COMPLETED
  SOLD
}

enum TaskStatus {
  PENDING_ESTIMATE
  ASSIGNED_OR_TO_DO
  IN_PROGRESS
  PENDING_INSPECTION_OR_QA
  INVOICE_SUBMITTED
  UNASSIGNED
  WON
  LOST
  OTHER
}

enum EstimateStatus {
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum AgreementStatus {
  UNSIGNED
  SIGNED
}

enum PaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
}

enum ActorType {
  USER
  SUBCONTRACTOR
  AI
}

// ==========================================
// ENTIDADES PRINCIPALES (CORE)
// ==========================================

model User {
  id             String    @id @default(uuid())
  name           String
  email          String?   @unique
  role           UserRole  @default(OPS_MANAGER)
  whatsappNumber String?   @unique // Para que Lucy 2.0 le envíe alertas a Leslie/Spencer
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("users")
}

model Subcontractor {
  id             String              @id @default(uuid())
  name           String
  company        String?
  email          String?
  hasW9          Boolean             @default(false)
  tradeSpecialty String?             // Plomería, Electricidad, Jardinería, etc.
  whatsappNumber String              @unique // Clave para la integración con WhatsApp
  status         SubcontractorStatus @default(ACTIVE)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  // Relaciones
  tasks          Task[]
  estimates      Estimate[]
  agreements     Agreement[]
  invoices       InvoicePayment[]

  @@map("subcontractors")
}

model Property {
  id                  String         @id @default(uuid())
  address             String         @unique
  status              PropertyStatus @default(RENOVATING)
  accessCodeOrLockbox String?        // Código para enviar al contratista vía WhatsApp
  
  // -- NUEVOS CAMPOS (La Crema de los Tacos) --
  county              String?
  subdivision         String?
  parcelId            String?
  propertyType        String?
  beds                Float?
  baths               Float?
  sqft                Int?
  lotSize             Int?
  yearBuilt           Int?
  sellerName          String?
  buyerName           String?        @default("Volunteer Homes, LLC")
  strategy            String?        // ej. "Rental", "Flip"
  isRaisingCapital    Boolean        @default(false)
  closeDate           DateTime?
  purchasePrice       Decimal?       @db.Decimal(10, 2)
  avm                 Decimal?       @db.Decimal(10, 2)
  estRent             Decimal?       @db.Decimal(10, 2)

  // Detalles Financieros / Préstamo
  loanLender          String?
  loanAmount          Decimal?       @db.Decimal(10, 2)
  loanRate            String?
  loanMonthly         Decimal?       @db.Decimal(10, 2)
  loanMaturity        DateTime?      // Fecha del Balloon
  loanHoldback        Decimal?       @db.Decimal(10, 2)
  loanCashToClose     Decimal?       @db.Decimal(10, 2)

  // Detalles del Inquilino (Tenant)
  tenantName          String?
  leaseTerm           String?

  // -- CLOSING / WORKFLOW CHECKLIST --
  clPsaSigned         Boolean        @default(false)
  clAltaFiled         Boolean        @default(false)
  clLoanDocsFiled     Boolean        @default(false)
  clClosed            Boolean        @default(false)
  clRehabComplete     Boolean        @default(false)
  clBuyerFound        Boolean        @default(false)

  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  // Relaciones Existentes
  tasks               Task[]
  media               Media[]
  estimates           Estimate[]
  agreements          Agreement[]
  invoices            InvoicePayment[]
  activityLogs        ActivityLog[]

  // Relaciones Nuevas
  conditionNotes      ConditionNote[]
  comparables         Comparable[]

  @@map("properties")
}

// ==========================================
// NUEVAS TABLAS PARA "LA CREMA DE LOS TACOS"
// ==========================================

model ConditionNote {
  id          String   @id @default(uuid())
  propertyId  String
  category    String   // ej. "Roof", "Carpet", "Bathroom"
  description String   // ej. "Needs full replacement"
  isCritical  Boolean  @default(false) // Para poner el ⚠️
  createdAt   DateTime @default(now())

  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("condition_notes")
}

enum CompType {
  SALE
  RENT
}

model Comparable {
  id          String   @id @default(uuid())
  propertyId  String
  type        CompType
  address     String
  specs       String?  // ej. "3/2 · 1,862 sqft"
  price       Decimal  @db.Decimal(10, 2)
  status      String?  // ej. "Inactive", "Sold"
  distance    String?  // ej. "1.0mi"
  createdAt   DateTime @default(now())

  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@map("comparables")
}

// ==========================================
// OPERACIONES Y FLUJO DE TRABAJO (WORKFLOW)
// ==========================================

model Task {
  id               String      @id @default(uuid())
  propertyId       String
  subcontractorId  String?     // Opcional hasta que se le asigne a alguien
  description      String      // Ej. "Cortar el pasto en Brotherwood"
  status           TaskStatus  @default(UNASSIGNED)
  dueDate          DateTime?
  lastContactedAt  DateTime?   // Para las alertas de "han pasado 3 días sin noticias"
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  // Relaciones
  property         Property       @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  subcontractor    Subcontractor? @relation(fields: [subcontractorId], references: [id], onDelete: SetNull)
  media            Media[]

  @@index([propertyId])
  @@index([subcontractorId])
  @@map("tasks")
}

model Media {
  id          String   @id @default(uuid())
  propertyId  String
  taskId      String?  // Opcional: si la foto prueba el avance de una tarea específica
  fileUrl     String   // URL del bucket en S3/Supabase Storage
  fileType    String   @default("image") // Ej. "image", "pdf", "document"
  uploadedBy  String?  // Puede ser el ID del contratista o del usuario
  createdAt   DateTime @default(now())

  // Relaciones
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  task        Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  @@index([propertyId])
  @@index([taskId])
  @@map("media")
}

// ==========================================
// FINANZAS Y CONTRATOS (BUROCRACIA)
// ==========================================

model Estimate {
  id                 String         @id @default(uuid())
  propertyId         String
  subcontractorId    String
  workDescription    String?        @db.Text
  estimatedStartDate DateTime?
  documentUrl        String?        // Enlace al archivo o foto del presupuesto
  amount             Decimal        @db.Decimal(10, 2)
  status             EstimateStatus @default(UNDER_REVIEW)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  // Relaciones
  property         Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  subcontractor    Subcontractor @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([subcontractorId])
  @@map("estimates")
}

model Agreement {
  id               String          @id @default(uuid())
  propertyId       String
  subcontractorId  String
  documentUrl      String?         // Contrato firmado
  status           AgreementStatus @default(UNSIGNED)
  signedAt         DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  // Relaciones
  property         Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  subcontractor    Subcontractor @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([subcontractorId])
  @@map("agreements")
}

model InvoicePayment {
  id               String        @id @default(uuid())
  propertyId       String
  subcontractorId  String
  workDescription  String?       @db.Text
  startDate        DateTime?
  finishDate       DateTime?
  agreedAmount     Decimal       @db.Decimal(10, 2)
  requestedAmount  Decimal       @db.Decimal(10, 2)
  amountPaid       Decimal       @default(0.00) @db.Decimal(10, 2)
  invoiceUrl       String?       // Foto o PDF del recibo/factura
  status           PaymentStatus @default(PENDING)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  // Relaciones
  property         Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  subcontractor    Subcontractor @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([subcontractorId])
  @@map("invoices_payments")
}

// ==========================================
// HISTORIAL Y AUDITORÍA (ACTIVITY LOG / CEREBRO IA)
// ==========================================

model ActivityLog {
  id          String    @id @default(uuid())
  propertyId  String
  actorType   ActorType // USER, SUBCONTRACTOR o AI
  actorName   String    // Ej. "Lucy 2.0", "Moises", "Leslie"
  action      String    // Ej. "TASK_COMPLETED", "WHATSAPP_SENT", "PHOTO_UPLOADED"
  description String    // Ej. "Moises reportó pasto cortado en Brotherwood Cove"
  createdAt   DateTime  @default(now())

  // Relaciones
  property    Property  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([createdAt]) // Índice para ordenar rápido las líneas de tiempo por fecha
  @@map("activity_logs")
}